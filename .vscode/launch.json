{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Example: Browser",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--workspace=example/browser"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "cwd": "${workspaceRoot}",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Example: Expo iOS",
      "request": "launch",
      "type": "node",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "ios", "--workspace=example/expo"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "cwd": "${workspaceRoot}",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Example: Express",
      "program": "${workspaceRoot}/example/express/app.js",
      "request": "launch",
      "cwd": "${workspaceRoot}/example/express",
      "skipFiles": ["<node_internals>/**"],
      "type": "node"
    },
    {
      "name": "Example: Next.js",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--workspace=example/nextjs"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "cwd": "${workspaceRoot}",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Example: React",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start", "--workspace=example/react"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "cwd": "${workspaceRoot}",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Example: SvelteKit",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--workspace=example/svelte-kit"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "cwd": "${workspaceRoot}",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Example: Vue",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--workspace=example/vue"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "cwd": "${workspaceRoot}",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Test",
      "request": "launch",
      "type": "node",
      "program": "${workspaceFolder}/node_modules/.bin/vitest",
      "args": ["--run"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "windows": {
        "program": "${workspaceFolder}/node_modules/vitest/vitest.mjs"
      },
      "cwd": "${workspaceRoot}"
    },
    {
      "name": "Test Current File",
      "request": "launch",
      "type": "node",
      "program": "${workspaceFolder}/node_modules/.bin/vitest",
      "args": ["--run", "${fileBasenameNoExtension}"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "windows": {
        "program": "${workspaceFolder}/node_modules/vitest/vitest.mjs"
      },
      "cwd": "${workspaceRoot}"
    }
  ]
}
