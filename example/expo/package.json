{
  "name": "expo-example",
  "private": true,
  "version": "3.0.0-dev",
  "main": "./index.js",
  "scripts": {
    "start": "expo start --dev-client --localhost",
    "start:ios": "expo start --dev-client --ios --localhost",
    "start:web": "expo start --web",
    "ios": "REACT_NATIVE_PACKAGER_HOSTNAME=localhost expo run:ios",
    "web": "expo export --platform web",
    "prebuild": "expo prebuild --clean --no-install",
    "android": "expo run:android"
  },
  "dependencies": {
    "@exceptionless/react-native": "3.0.0-dev",
    "@expo/metro-runtime": "~58.0.14",
    "@react-native-async-storage/async-storage": "3.1.1",
    "expo": "~58.0.14",
    "expo-application": "~58.1.2",
    "expo-constants": "~58.0.12",
    "expo-dev-client": "~58.0.14",
    "expo-device": "~58.0.5",
    "expo-splash-screen": "~58.0.10",
    "expo-status-bar": "~58.0.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@react-native/js-polyfills": "^0.88.0",
    "@types/react": "~19.3.0",
    "typescript": "~7.0.2"
  },
  "publishConfig": {
    "access": "restricted"
  }
}
