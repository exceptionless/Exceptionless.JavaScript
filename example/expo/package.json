{
  "name": "expo-example",
  "private": true,
  "version": "3.0.0-dev",
  "main": "./index.js",
  "scripts": {
    "start": "expo start --dev-client --localhost",
    "start:ios": "expo start --dev-client --ios --localhost",
    "start:web": "expo start --web",
    "ios": "REACT_NATIVE_PACKAGER_HOSTNAME=localhost expo run:ios",
    "web": "expo export --platform web",
    "prebuild": "expo prebuild --clean --no-install",
    "android": "expo run:android"
  },
  "dependencies": {
    "@exceptionless/react-native": "3.0.0-dev",
    "@expo/metro-runtime": "~56.0.15",
    "@react-native-async-storage/async-storage": "3.1.1",
    "expo": "~56.0.11",
    "expo-application": "~56.0.3",
    "expo-constants": "~56.0.16",
    "expo-dev-client": "~56.0.20",
    "expo-device": "~56.0.4",
    "expo-splash-screen": "~56.0.10",
    "expo-status-bar": "~56.0.4",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-native": "0.85.3",
    "react-native-safe-area-context": "~5.8.0",
    "react-native-screens": "4.25.2",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@react-native/js-polyfills": "^0.86.0",
    "@types/react": "~19.2.17",
    "typescript": "~6.0.3"
  },
  "publishConfig": {
    "access": "restricted"
  }
}
